# Backend environment configuration (copy to .env and fill in).
# NEVER commit a real .env — secrets stay out of version control (constitution Principle IV).

# PostgreSQL connection string (docker-compose provides a local instance on 5432).
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_auth?schema=public"

# Separate database used by the integration test suite.
TEST_DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_auth_test?schema=public"

# Strong random secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# Token lifetime (default 24h per spec assumption).
JWT_EXPIRES_IN="24h"

# API port.
PORT="3000"
